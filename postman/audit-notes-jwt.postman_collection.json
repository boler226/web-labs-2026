{
  "info": {
    "name": "Audit notes — 5 JWT requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all 8 requests in order. Set local password collection variables first; tokens and noteId are saved automatically."
  },
  "item": [
    {
      "name": "Setup — issue JWTs",
      "item": [
        {
          "name": "Setup — VIEWER token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "viewer",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{viewerPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token viewer: 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"viewerToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — EDITOR token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "editor",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{editorPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token editor: 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"editorToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — ADMIN token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token admin: 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Five audit note requests",
      "item": [
        {
          "name": "1. VIEWER list denied",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-notes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{viewerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1. VIEWER list denied: 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. EDITOR lists notes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-notes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{editorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2. EDITOR lists notes: 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. EDITOR create denied",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/audit-notes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{editorToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Editor cannot add audit notes\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"3. EDITOR create denied: 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. ADMIN creates note",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/audit-notes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Postman JWT audit lab note\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4. ADMIN creates note: 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"noteId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. ADMIN gets note",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-notes/{{noteId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"5. ADMIN gets note: 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Created note returned\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"noteId\"))));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "viewerPassword",
      "value": ""
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "editorPassword",
      "value": ""
    },
    {
      "key": "editorToken",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "noteId",
      "value": ""
    }
  ]
}
